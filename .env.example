APP_NAME="One Stop Gadgets"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=one_stop_gadgets
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=osg_session
SESSION_SECURE=false

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=example@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=example@gmail.com
SMTP_FROM_NAME="One Stop Gadgets"

LUCKY_DIP_ENABLED=true
PAYMENTS_LIVE_ENABLED=false
